@model Product_Catelog.Models.Product

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Product Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa, #e4ecf7);
            min-height: 100vh;
            font-family: Arial, sans-serif;
        }

        .header {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: white;
            padding: 30px 20px;
            text-align: center;
            margin-bottom: 40px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

            .header h1 {
                font-weight: 700;
                margin: 0;
            }

        .product-card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            max-width: 850px;
            margin: auto;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }

        .product-image {
            width: 100%;
            max-width: 400px;
            height: 280px;
            object-fit: cover;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        .product-info {
            padding: 10px;
        }

            .product-info p {
                font-size: 17px;
                padding: 12px 15px;
                margin-bottom: 10px;
                background: #f8f9fa;
                border-radius: 8px;
            }

            .product-info strong {
                color: #343a40;
            }

        .price {
            color: #198754;
            font-size: 22px;
            font-weight: bold;
        }

        .back-btn {
            border-radius: 20px;
            padding: 9px 22px;
            margin-top: 15px;
        }
    </style>
</head>

<body>

    <div class="header">
        <h1>🛍️ Product Details</h1>
    </div>

    <div class="container pb-5">

        <div class="product-card">

            <div class="row align-items-center g-4">

                <div class="col-md-6 text-center">
                    <img src="@Model.ImageUrl"
                         class="product-image"
                         alt="@Model.ProductName" />
                </div>

                <div class="col-md-6 product-info">

                    <h2 class="mb-4">@Model.ProductName</h2>

                    <p>
                        <strong>Product ID:</strong>
                        @Model.ProductId
                    </p>

                    <p>
                        <strong>Product Name:</strong>
                        @Model.ProductName
                    </p>

                    <p>
                        <strong>Category:</strong>
                        <span class="badge bg-secondary">
                            @Model.ProductCategory
                        </span>
                    </p>

                    <p>
                        <strong>Price:</strong>
                        <span class="price">₹@Model.ProductPrice</span>
                    </p>

                    @Html.ActionLink(
                        "← Back to Products",
                        "Index",
                        "Products",
                        null,
                        new { @class = "btn btn-primary back-btn" }
                    )

                </div>

            </div>

        </div>

    </div>

</body>
</html>